# Supabase (region: Singapore)
NEXT_PUBLIC_SUPABASE_URL=

# Sistem API key BARU (sb_publishable_… / sb_secret_…), menggantikan anon/service_role lama.
# Publishable key memang ikut ter-bundle di klien — itu wajar, RLS yang menjaganya.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya untuk skrip server & seeding. Membypass RLS sepenuhnya.
# JANGAN pernah masuk ke bundle klien, dan jangan pernah dikirim lewat chat.
SUPABASE_SECRET_KEY=

# Rahasia penandatangan JWT anak, dipakai Edge Function `child-login`.
# NAMANYA TIDAK BOLEH berprefix SUPABASE_ — prefix itu direservasi Supabase,
# `supabase secrets set SUPABASE_...` ditolak, dan nilainya jadi undefined saat runtime.
#   supabase secrets set CHILD_JWT_SECRET=<jwt secret proyek>
CHILD_JWT_SECRET=
